# Configuração do PokéGarden — copie para `.env` e preencha.

# Chave da API da OpenAI (usada pelo OpenAI Agents SDK).
OPENAI_API_KEY=

# Modelo usado pelo agente conversacional.
OPENAI_MODEL=gpt-4o-mini

# URL base da PokéAPI.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# Diretório de cache local.
CACHE_DIR=.cache

# Expiração (em segundos) das entradas de cache da PokéAPI.
CACHE_TTL_SECONDS=86400

# Nível de log da aplicação (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Arquivo de logs JSON (uma linha por evento). Vazio = só stderr.
LOG_FILE=logs/pokegarden.jsonl

# Perfil de tools do agente: B = todas; A = sem get_evolution_chain.
POKEGARDEN_TOOLS_PROFILE=A
