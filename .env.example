# Configuração do PokéGarden — copie para `.env` e preencha.

# Chave da API da OpenAI (usada pelo SDK nas próximas sessões).
OPENAI_API_KEY=

# URL base da PokéAPI.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# Diretório de cache local.
CACHE_DIR=.cache

# Nível de log da aplicação (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
